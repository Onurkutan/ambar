    "      reads_->fetch_add(1, std::memory_order_relaxed);",
    "      ;"
  ],
  "table reads: leave the bytes unmoved": [
    "src/table_cache.cpp",
    "      bytes_->fetch_add(n, std::memory_order_relaxed);",
    "      ;"
  ],
  "table cache: hand the table its file unwrapped": [
    "src/table_cache.cpp",
    "  std::unique_ptr<RandomAccessFile> file = std::make_unique<CountingFile>(\n      std::move(opened), &reads_, &bytes_read_);",
